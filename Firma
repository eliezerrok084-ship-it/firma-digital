<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Firma Digital - Inversiones ROCA</title>
    <style>
        * { box-sizing: border-box; }
        body { 
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; 
            background: #f1f5f9; 
            color: #1e293b; 
            display: flex; 
            justify-content: center; 
            align-items: center; 
            min-height: 100vh; 
            margin: 0; 
            padding: 15px; 
        }
        .card { 
            background: #ffffff; 
            color: #1e293b; 
            width: 100%; 
            max-width: 420px; 
            border-radius: 20px; 
            padding: 25px; 
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.1), 0 8px 10px -6px rgba(0, 0, 0, 0.1); 
            text-align: center; 
            border: 1px solid #e2e8f0;
        }
        h2 { 
            margin: 0 0 5px 0; 
            color: #1e3a8a; 
            font-size: 22px; 
            font-weight: 800;
            letter-spacing: -0.5px; 
        }
        .subtitulo {
            font-size: 13px;
            color: #64748b;
            margin-bottom: 20px;
            font-weight: 500;
        }
        .cliente-box { 
            background: #f8fafc; 
            border: 1px solid #cbd5e1; 
            padding: 12px; 
            border-radius: 12px; 
            margin-bottom: 20px; 
            font-weight: 700; 
            color: #0f172a; 
            font-size: 15px; 
            box-shadow: inset 0 1px 2px rgba(0,0,0,0.02);
        }
        .instruccion { 
            font-size: 13px; 
            color: #475569; 
            margin-bottom: 8px; 
            font-weight: 600; 
        }
        canvas { 
            border: 2px dashed #94a3b8; 
            border-radius: 14px; 
            background: #ffffff; 
            touch-action: none; 
            width: 100%; 
            height: 260px; 
            display: block; 
            cursor: crosshair; 
            box-shadow: inset 0 2px 4px rgba(0,0,0,0.02);
        }
        .btn-group { 
            display: grid; 
            grid-template-columns: 1fr 1fr; 
            gap: 12px; 
            margin-top: 20px; 
        }
        button { 
            border: none; 
            padding: 16px; 
            border-radius: 12px; 
            font-weight: bold; 
            cursor: pointer; 
            font-size: 14px; 
            transition: all 0.2s ease; 
        }
        .btn-clear { 
            background: #f1f5f9; 
            color: #475569; 
            border: 1px solid #cbd5e1;
        }
        .btn-clear:active { background: #e2e8f0; }
        .btn-send { 
            background: #1e3a8a; 
            color: white; 
            box-shadow: 0 4px 12px rgba(30, 58, 138, 0.3); 
        }
        .btn-send:active { transform: scale(0.97); background: #172554; }
    </style>
</head>
<body>

<div class="card">
    <h2>INVERSIONES ROCA</h2>
    <div class="subtitulo">Sistema de Firma Digital Segura</div>
    
    <div class="cliente-box" id="info-cliente">Cargando datos del cliente...</div>
    
    <p class="instruccion">Firme aquí con su dedo (Trazo Azul Marino)</p>
    <canvas id="canvas-firma"></canvas>

    <div class="btn-group">
        <button class="btn-clear" onclick="limpiar()">REPETIR</button>
        <button class="btn-send" onclick="enviar()">ENVIAR FIRMA</button>
    </div>
</div>

<script>
    const canvas = document.getElementById('canvas-firma');
    const ctx = canvas.getContext('2d');
    let dibujando = false;

    function ajustarResolucion() {
        const rect = canvas.getBoundingClientRect();
        canvas.width = rect.width * 2;
        canvas.height = rect.height * 2;
        ctx.scale(2, 2);
        ctx.strokeStyle = "#1e3a8a"; 
        ctx.lineWidth = 2.5;
        ctx.lineCap = "round";
        ctx.lineJoin = "round";
    }

    const urlParams = new URLSearchParams(window.location.search);
    const nombre = urlParams.get('nom') || "CLIENTE";
    const ci = urlParams.get('ci') || "";
    document.getElementById('info-cliente').innerText = `${nombre} \n CI: ${ci}`;

    window.onload = ajustarResolucion;

    function obtenerPos(e) {
        const r = canvas.getBoundingClientRect();
        const clientX = e.touches ? e.touches[0].clientX : e.clientX;
        const clientY = e.touches ? e.touches[0].clientY : e.clientY;
        return { x: clientX - r.left, y: clientY - r.top };
    }

    function iniciar(e) {
        dibujando = true;
        const p = obtenerPos(e);
        ctx.beginPath();
        ctx.moveTo(p.x, p.y);
    }

    function mover(e) {
        if (!dibujando) return;
        e.preventDefault();
        const p = obtenerPos(e);
        ctx.lineTo(p.x, p.y);
        ctx.stroke();
    }

    function detener() { dibujando = false; }

    canvas.addEventListener('mousedown', iniciar);
    canvas.addEventListener('mousemove', mover);
    window.addEventListener('mouseup', detener);

    canvas.addEventListener('touchstart', iniciar, {passive: false});
    canvas.addEventListener('touchmove', mover, {passive: false});
    canvas.addEventListener('touchend', detener);

    function limpiar() { ctx.clearRect(0, 0, canvas.width, canvas.height); }

    function enviar() {
        const firmaBase64 = canvas.toDataURL("image/png");
        
        if (firmaBase64.length < 2000) {
            return alert("Por favor, realice su firma antes de enviar.");
        }

        const tuTelefono = "56994954980"; // Tu número real configurado
        
        const mensaje = `*INVERSIONES ROCA - FIRMA DIGITAL*%0A` +
                         `*Cliente:* ${nombre}%0A` +
                         `*CI:* ${ci}%0A%0A` +
                         `*CÓDIGO DE FIRMA (Copiar todo):*%0A${firmaBase64}`;

        window.location.href = `https://wa.me/${tuTelefono}?text=${mensaje}`;
    }
</script>

</body>
</html>
